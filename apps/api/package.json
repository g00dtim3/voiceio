    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
